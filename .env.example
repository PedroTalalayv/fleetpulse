# Copie para .env (ignorado pelo Git) e troque os valores change-me.
# Lido pelo Docker Compose (compose.yaml).

# Database compartilhado e administrador da instância
POSTGRES_DB=fleetpulse_db
POSTGRES_USER=fleetpulse_admin
POSTGRES_PASSWORD=change-me

# Senha do usuário identity_service, criado por infra/postgres/init/01-identity.sh.
# Deve ser igual a IDENTITY_DB_PASSWORD em identity-service/.env.
IDENTITY_DB_PASSWORD=change-me
