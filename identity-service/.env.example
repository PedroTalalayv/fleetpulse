# Copie para .env (ignorado pelo Git) e troque o valor change-me.
# Lido pelo identity-service (spring.config.import em application.yml).
# Variáveis de ambiente do sistema têm prioridade sobre este arquivo.

# Aplicação fora de container: porta publicada pelo Docker.
# Aplicação dentro de container: jdbc:postgresql://postgres:5432/fleetpulse_db
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/fleetpulse_db
IDENTITY_DB_USERNAME=identity_service
IDENTITY_DB_PASSWORD=change-me
